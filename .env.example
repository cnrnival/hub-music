# ============================================
# HUB MUSIC — VARIÁVEIS DE AMBIENTE (EXEMPLO)
# Copie este arquivo para .env e preencha com seus valores
# NUNCA coloque senhas reais neste arquivo
# ============================================

# Server
PORT=3000
NODE_ENV=development
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL via Render)
# O Render cria o banco automaticamente e fornece a DATABASE_URL
# No Render, configure DATABASE_URL diretamente no painel
# Ex: postgresql://usuario:senha@host:5432/banco
DATABASE_URL="postgresql://usuario:senha@host:5432/banco"

# JWT (mude estas chaves em produção!)
JWT_SECRET=sua-chave-jwt-secreta-muito-longa-e-aleatoria
JWT_REFRESH_SECRET=sua-chave-jwt-refresh-diferente-e-longa
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookie
COOKIE_SECRET=sua-chave-de-cookie-secreta

# APIs Públicas (sem upload de músicas dos artistas)
DEEZER_API_URL=https://api.deezer.com
MUSICBRAINZ_USER_AGENT=HubMusic/1.0 (https://github.com/seu-usuario/hub-music)
FREETOUSE_API_URL=https://api.freetouse.com/v3
JAMENDO_CLIENT_ID=
JAMENDO_API_URL=https://api.jamendo.com/v3.0
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
LRCLIB_API_URL=https://lrclib.net/api
SAYMUSIC_API_URL=https://sayamusicapi.shnwazdeveloperx.workers.dev

# Email (opcional - Resend/SendGrid)
RESEND_API_KEY=
EMAIL_FROM=noreply@hubmusic.local

# Monitoramento (opcional)
SENTRY_DSN=
UPTIMEROBOT_API_KEY=
