# Hub Music Frontend - Environment Variables
# Copy to .env and fill in your values
# All values must be set in Vercel dashboard for production

# Backend API URL (URL do seu backend no Render)
# Ex: https://hub-music-backend.onrender.com
VITE_API_URL=https://seu-backend.onrender.com

# App Configuration
VITE_APP_NAME=Hub Music
VITE_APP_URL=https://seu-app.vercel.app

# Analytics (optional)
VITE_GA_ID=
VITE_PLAUSIBLE_DOMAIN=

# Error tracking (optional)
VITE_SENTRY_DSN=

# Feature flags
VITE_ENABLE_PWA=true
VITE_ENABLE_OFFLINE=true